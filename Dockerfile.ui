# Dockerfile for React UI Frontend
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY ui/package*.json ./

# Install dependencies
RUN npm install

# Copy UI source code
COPY ui/ .

# Expose Vite dev server port
EXPOSE 5173

# Run Vite dev server (accessible from host)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
